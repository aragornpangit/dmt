# dmt 内网端点配置模板
#
# 用法：复制为 .env 并填入你自己的内网地址，脚本与文档统一用这些变量名引用。
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# .env 不入库（见 .gitignore）—— 内网地址属于环境私有信息，不随仓库分发。
# 脚本通过 dmt_load_env（dmt-dir/scripts/lib-dmt.sh）读取本文件。

# 内网 GitLab（推送代码用；dmt-dm 的 publish.sh 目标）
DMT_GITLAB_SERVER=gitlab.example.internal
DMT_GITLAB_PORT=808

# 内网 GitLab 上的仓库路径（推送远端）
DMT_GITLAB_REPO=group/project.git

# 本地复核器（autoModeClassifier）模型端点：OpenAI 兼容 /v1/models
DMT_LOCAL_MODEL_HOST=localhost
DMT_LOCAL_MODEL_PORT=30000

# 本地复核器模型 id
DMT_AUTO_REVIEW_LOCAL_MODEL=custom-local:Qwen3.8-27b

# 8 个 mattpocock 第三方技能的上游来源（契约 third_party_skills.source_url 的展开来源）
# 派发 dir/dm/am 时经 dmt_load_env 展开后随 prompt 带入上下文；仅作来源登记，不 fetch/加载。
# 模板用占位符，不入库真实内网地址；.env 里填实际值。
DMT_MATTPOCOCK_SOURCE_URL=https://git.example.internal/group/mattpocock-skills.git
